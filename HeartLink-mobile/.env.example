# ==============================================================================
# HeartLink Mobile Environment Configuration (Expo / React Native)
# ==============================================================================
#
# USAGE:
#   - For LOCAL development:  Use this file as-is (localhost)
#   - For STAGING builds:     Copy .env.staging → .env
#   - For PRODUCTION builds:  Copy .env.production → .env
#
# RENDER BACKEND URLS:
#   Staging:    https://heartlink-staging.onrender.com    (deploys from 'staging' branch)
#   Production: https://heartlink-app-b8ba.onrender.com   (deploys from 'main' branch)
# ==============================================================================

# ---------------------------------------------------------
# API BASE URL CONFIGURATION
# To switch environments, uncomment the one you want to use
# and comment out the others.
# ---------------------------------------------------------

# 1. PRIMARY / BACKUP (Railway)
EXPO_PUBLIC_API_URL=https://heartlink-api-production-46db.up.railway.app

# 2. PRIMARY (Render) - Currently Suspended until Oct 1
# EXPO_PUBLIC_API_URL=https://heartlink-staging.onrender.com

# 3. LOCAL DEVELOPMENT (Must use your computer's local IP address, e.g., 192.168.x.x, instead of localhost when testing on a physical device)
# EXPO_PUBLIC_API_URL=http://192.168.1.xxx:8000

# Public Supabase Client (Optional if direct client auth is used; Anon key only)
# IMPORTANT: NEVER place SUPABASE_SERVICE_ROLE_KEY here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
