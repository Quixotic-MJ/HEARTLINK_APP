# ==============================================================================
# HeartLink Backend Environment Configuration
# ==============================================================================

# Database Persistence Mode: 'mock' (offline JSON fallback) or 'supabase' (PostgreSQL)
DATABASE_MODE=supabase

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (SERVER-SIDE ONLY)
# CAUTION: Never expose SUPABASE_SERVICE_ROLE_KEY to mobile or web clients.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# JWT & AUTHENTICATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# REQUIRED: 32+ character random cryptographic secret for signing application JWT tokens.
# The backend will crash on startup if this is missing.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-if-using-direct-supabase-jwt

# ------------------------------------------------------------------------------
# SIGN-UP CODE EMAIL (HL-052)
# Each sign-up gets its own 6-digit code by email (valid 10 minutes, 5 tries).
# Two ways to send it (Brevo wins when both are set):
# 1. Brevo (free, 300 emails/day, works on Railway/Render because it uses HTTPS):
#    BREVO_API_KEY = an API key from Brevo > SMTP & API > API Keys,
#    MAIL_FROM = a sender address verified in Brevo > Senders.
# BREVO_API_KEY=xkeysib-your-key
# 2. SMTP: set all of SMTP_HOST, SMTP_USER, SMTP_PASSWORD and MAIL_FROM.
# Gmail: smtp.gmail.com, port 587 (STARTTLS), SMTP_USER and MAIL_FROM = the Gmail
# address, SMTP_PASSWORD = a 16-letter Google "app password" (not the normal
# Gmail password; needs 2-Step Verification on that Google account).
# Port 465 uses SSL instead. Note: Render's free tier and Railway below Pro
# block outgoing SMTP, so email only sends from a paid instance there.
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=heartlink.app@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# MAIL_FROM=heartlink.app@gmail.com

# ------------------------------------------------------------------------------
# DEVELOPMENT SIGN-UP CODE (HL-045)
# Only used when the email settings above are NOT set, and never when
# ENVIRONMENT=production (there, sign-up stays closed until email is set up).
# DEV_OTP_ENABLED defaults to true outside production; DEV_OTP_CODE to 123456.
# ------------------------------------------------------------------------------
# DEV_OTP_ENABLED=true
# DEV_OTP_CODE=123456

# ------------------------------------------------------------------------------
# CORS ORIGIN WHITELIST (COMMA SEPARATED URLS)
# Include your Render/Vercel frontend domain, local dev ports, etc.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8000,http://127.0.0.1:5173,https://your-web-portal.onrender.com,https://your-web-portal.vercel.app

# ------------------------------------------------------------------------------
# WEB PORTAL SESSION COOKIES (HL-033)
# Admin JWT is stored in an HttpOnly, Secure, SameSite=Strict cookie.
# Set to "false" ONLY for local development over plain http.
# ------------------------------------------------------------------------------
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# RATE LIMIT CLIENT IP (TRUSTED REVERSE PROXIES)
# How many proxies in front of the API append to X-Forwarded-For.
# 0 = local/dev (use the direct peer). Railway only = 1. Vercel /api rewrite -> Railway = 2.
# ------------------------------------------------------------------------------
TRUSTED_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# ENVIRONMENT
# Set to "production" on Railway: hides /docs and /redoc, and production rules
# apply (for example the shared sign-up code above is off). Leave unset locally.
# ------------------------------------------------------------------------------
# ENVIRONMENT=production

# ------------------------------------------------------------------------------
# AI FEATURES (OPTIONAL - the app works without them)
# GROQ_API_KEY powers the dashboard insight text.
# COMPANION_LLM_* powers the chat companion; it is off unless ENABLED=true.
# ------------------------------------------------------------------------------
# GROQ_API_KEY=your-groq-api-key
# COMPANION_LLM_ENABLED=false
# COMPANION_LLM_API_KEY=your-groq-api-key
# COMPANION_LLM_BASE_URL=https://api.groq.com/openai/v1
# COMPANION_LLM_MODEL=llama-3.1-8b-instant
# COMPANION_LLM_TIMEOUT_S=8
# COMPANION_LLM_DAILY_CAP=10
