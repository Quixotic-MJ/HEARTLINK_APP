# ==============================================================================
# HeartLink Web Admin / Medical Expert Portal Configuration (Vite / React)
# ==============================================================================

# Public API Gateway (FastAPI Backend URL)
# Leave EMPTY: the portal calls /api same-origin so the HttpOnly, SameSite=Strict
# session cookie is sent (HL-033). Dev uses the Vite proxy, prod the vercel.json rewrite.
VITE_API_URL=

# Backend the Vite dev server proxies /api to (dev only)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Public Supabase Client (Anon key only)
# IMPORTANT: NEVER place SUPABASE_SERVICE_ROLE_KEY here.
# Not used: the app talks only to the backend, never to Supabase directly (migration 020 blocks it).
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
