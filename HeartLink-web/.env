# ---------------------------------------------------------
# API BASE URL CONFIGURATION
# HL-033: the portal calls /api same-origin so the HttpOnly,
# SameSite=Strict session cookie is sent. Keep VITE_API_URL empty
# and pick which backend the Vite dev proxy forwards to below.
# (Production uses the /api rewrite in vercel.json.)
# ---------------------------------------------------------
VITE_API_URL=

# 1. PRIMARY / BACKUP (Railway)
# VITE_PROXY_TARGET=https://heartlink-api-production-46db.up.railway.app

# 2. PRIMARY (Render) - Currently Suspended until Oct 1
# VITE_PROXY_TARGET=https://heartlink-staging.onrender.com

# 3. LOCAL DEVELOPMENT
VITE_PROXY_TARGET=http://127.0.0.1:8000
