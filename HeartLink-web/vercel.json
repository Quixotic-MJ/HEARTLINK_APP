{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://heartlink-api-production-46db.up.railway.app/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://heartlink-api-production-46db.up.railway.app/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
