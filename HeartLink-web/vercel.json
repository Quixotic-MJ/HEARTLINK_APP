{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://heartlink-api-production-46db.up.railway.app/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://heartlink-api-production-46db.up.railway.app/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
